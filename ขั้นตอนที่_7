    },
    {
      "cell_type": "code",
      "source": [
        "# Q1: หมวดไหนถูกยืมมากที่สุด?\n",
        "q1 = pd.read_sql_query(\"\"\"\n",
        "    SELECT b.category_name,\n",
        "           COUNT(*) AS total_loans,\n",
        "           SUM(l.late_fee) AS total_late_fee\n",
        "    FROM loans l\n",
        "    JOIN books b ON l.book_id = b.book_id\n",
        "    GROUP BY b.category_name\n",
        "    ORDER BY total_loans DESC;\n",
        "\"\"\", conn)\n",
        "print(\"SQL Q1:\", q1)"
      ],
      "metadata": {
        "id": "ylHbJlMWkXnY"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Q2: สมาชิกประเภทไหนคืนหนังสือช้ากว่า?\n",
        "q2 = pd.read_sql_query(\"\"\"\n",
        "    SELECT m.member_type,\n",
        "           COUNT(*) AS total_loans,\n",
        "           AVG(l.late_fee) AS avg_late_fee\n",
        "    FROM loans l\n",
        "    JOIN members m ON l.member_id = m.member_id\n",
        "    GROUP BY m.member_type\n",
        "    ORDER BY avg_late_fee DESC;\n",
        "\"\"\", conn)\n",
        "print(\"SQL Q2:\", q2)"
      ],
      "metadata": {
        "id": "_SSxWVn4kZxX"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Q3: ใครคืนช้าที่สุด (Top late fee)\n",
        "q3 = pd.read_sql_query(\"\"\"\n",
        "    SELECT loan_id, book_id, member_id, member_name, late_fee\n",
        "    FROM loans\n",
        "    WHERE late_fee > 0\n",
        "    ORDER BY late_fee DESC;\n",
        "\"\"\", conn)\n",
        "print(\"SQL Q3:\", q3.head())"
      ],
      "metadata": {
        "id": "rfl6QPZtkdEL"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Q4: 5 สมาชิกที่ยืมบ่อยที่สุด\n",
        "q4 = pd.read_sql_query(\"\"\"\n",
        "    SELECT m.name, COUNT(*) AS total_borrows\n",
